// =====================================================================
// FIRESTORE RULES FOR PROMPTG (SECURE USER-SCOPED ACCESS)
// Copy the entire code below and paste it in:
// Firebase Console -> Firestore Database -> "Rules" tab -> Click "Publish"
// =====================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Prompts Collection: Scoped strictly to the authenticated creator
    match /prompts/{promptId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // User Profiles Collection: Only accessible by the account owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
